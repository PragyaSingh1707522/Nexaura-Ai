# Copy to .env. Keep credentials out of git.
POSTGRES_PASSWORD=change-me-before-deployment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional Ollama-compatible local endpoint, e.g. http://host.docker.internal:11434
LOCAL_SLM_URL=
LOCAL_SLM_MODEL=qwen2.5:3b
# Optional single-workspace authentication. Generate a scrypt hash with
# `cd backend; python scripts/hash_password.py`; set all three fields below.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SECRET=
AUTH_ROLE=admin
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
DATABASE_URL=sqlite:///./regulalens.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=regulatory_chunks
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INSTALL_ML=false
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=
RETRIEVAL_DEFAULT=hybrid_rerank
RISK_MODEL=selected
CLAUSE_MODEL=tfidf
VITE_API_BASE_URL=http://localhost:8000
